{
  "name": "hr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx serve admin",
    "dev:admin": "nx serve admin",
    "dev:employees": "nx serve employees",
    "build": "nx run-many -t build",
    "build:admin": "nx build admin",
    "build:backend": "dotnet build backend/HR.slnx",
    "build:employees": "nx build employees",
    "db:migrate": "dotnet tool run dotnet-ef database update --project backend/HR.Infrastructure --startup-project backend/HR.Api",
    "db:migration:add": "dotnet tool run dotnet-ef migrations add --project backend/HR.Infrastructure --startup-project backend/HR.Api",
    "dotnet:tools": "dotnet tool restore",
    "lint": "nx run-many -t lint",
    "lint:admin": "nx lint admin",
    "lint:employees": "nx lint employees",
    "dev:api": "dotnet run --project backend/HR.Api",
    "preview:admin": "nx preview admin",
    "preview:employees": "nx preview employees"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nx/react": "^23.1.0",
    "@nx/vite": "^23.1.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "nx": "^23.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
